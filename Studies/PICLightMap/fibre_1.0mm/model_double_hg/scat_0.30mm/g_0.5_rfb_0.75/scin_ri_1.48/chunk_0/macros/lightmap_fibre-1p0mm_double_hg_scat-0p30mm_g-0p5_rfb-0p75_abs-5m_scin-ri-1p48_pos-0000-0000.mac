/t2k/control baseline-2024-plusplus 1.0
# The baseline disables HOMO and enables HFG by default.  A light-map job must
# select HOMO explicitly before /t2k/update constructs the geometry.
/t2k/OA/Magnet/Basket/PlusPlusTracker/NoHFGCMD true
/t2k/OA/Magnet/Basket/PlusPlusTracker/NoHomoCMD false
/t2k/OA/Magnet/Basket/PlusPlusTracker/HOMO/Box/gapX 9 mm
/t2k/OA/Magnet/Basket/PlusPlusTracker/HOMO/Box/gapY 9 mm
/t2k/OA/Magnet/Basket/PlusPlusTracker/HOMO/Box/gapZ 9 mm
/t2k/OA/Magnet/Basket/PlusPlusTracker/HOMO/Box/HomoFiber/radius 0.5 mm
/t2k/phys/fullPhotonScintSim
/t2k/detector/liquidOScatteringModel double_hg
/t2k/detector/liquidOMieG 0.5
/t2k/detector/liquidOMieForwardFraction 0.75
/t2k/detector/liquidOMieScatLen 0.30 mm
/t2k/detector/liquidOabsLen 5 m
/t2k/detector/liquidORI 1.48
/t2k/random/randomSeed 990000
/t2k/random/showRandomSeed
/t2k/update
/gps/source/clear
/gps/source/multiplevertex true
/gps/source/clear
/gps/source/add 1
/gps/particle opticalphoton
/gps/ang/type iso
/gps/ang/maxtheta 180 deg
/gps/ang/rot1 -1 0 0
/gps/ang/rot2 0 1 0
/gps/number 1
/gps/ene/type Mono
/gps/ene/mono 1 eV
/gps/position -4.5 25.5 905.5 mm
/run/beamOn 1
/generator/add
