# ONE-POSITION VALIDATION ONLY.  This file queues exactly one job (index 0).
WORK_DIR = /nfs/pic.es/user/t/tlux/tlux/PICLightMap
SIF_IMAGE = $(WORK_DIR)/ND280Reco_03.sif
initialdir = $(WORK_DIR)

executable = run_lightmap_position.sh
arguments = $(POSITION_INDEX) $(NPHOTONS) $(SCAT_VALUE) $(SCAT_UNIT) $(ABS_VALUE) $(ABS_UNIT) $(SEED_BASE) $(FIBRE_DIAMETER_MM) positions.txt
# Safety contract with the worker script: light maps require the explicit
# HOMO optical geometry, never the baseline HFG configuration.
environment = "LIGHTMAP_DETECTOR=HOMO LIGHTMAP_PRODUCTION_TAG=fibre_$(FIBRE_DIAMETER_MM)mm/scat_$(SCAT_VALUE)mm"

# Current PIC supports running the executable directly inside this image.
+SingularityImage = "$(SIF_IMAGE)"

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
preserve_relative_paths = True
transfer_input_files = positions.txt,ValidateHomoGeometry.C
transfer_output_files = fibre_$(FIBRE_DIAMETER_MM)mm/scat_$(SCAT_VALUE)mm/position_$(POSITION_INDEX)

output = logs/fibre-$(FIBRE_DIAMETER_MM)mm.scat-$(SCAT_VALUE)mm.one-position.$(ClusterId).$(ProcId).out
error  = logs/fibre-$(FIBRE_DIAMETER_MM)mm.scat-$(SCAT_VALUE)mm.one-position.$(ClusterId).$(ProcId).err
log    = logs/fibre-$(FIBRE_DIAMETER_MM)mm.scat-$(SCAT_VALUE)mm.one-position.$(ClusterId).log

request_cpus = 1
request_memory = 12 GB
request_disk = 5 GB
+flavour = "medium"

# Validation uses exactly the same physics settings as the chunk production.
NPHOTONS = 100000
SCAT_VALUE = 0.25
SCAT_UNIT = mm
FIBRE_DIAMETER_MM = 1.0
ABS_VALUE = 5
ABS_UNIT = m
SEED_BASE = 730000

# Zero-based index.  Keep the queue block at one line for the first test.
queue POSITION_INDEX from (
0
)
