# Experimental LFGD column-hit construction.
#
# The standard 2D peak finding and 3D candidate construction run first.  The
# candidates are then collapsed to one charge-weighted point per 10 mm slice
# along the event's dominant detector axis.  That coordinate is fixed at the
# slice centre.  All later hit selection, clustering, spanning-tree processing,
# and track fitting are the unmodified official hfgRecon chain.
< hfgRecon.Hits3D.FindPeaks.homo = 1 >
< hfgRecon.Hits3D.PeakClusteringMode.homo = 1 >
< hfgRecon.Hits3D.UsePeakWeightedPosition.homo = 1 >
< hfgRecon.Hits3D.Min2DHitCharge.homo = 10.0 >
< hfgRecon.Hits3D.ChargeReconstructionMode.homo = 0 >
< hfgRecon.Hits3D.VoxelPositionMode.homo = 4 >
< hfgRecon.SelectHits3D.Enable.homo = 1 >
< hfgRecon.SelectHits3D.ChargeCut.homo = 10.0 >
